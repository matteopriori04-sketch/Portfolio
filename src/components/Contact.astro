---
/**
 * Contact — email, GitHub and a CV download button (placeholder PDF in /public).
 */
import { useTranslations } from '../i18n/utils';
import { sections } from '../i18n/content';
import { SITE, CONTACTS } from '../consts';
import Email from './Email.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = sections[lang];
---

<section id="contact" class="border-t border-border py-24">
  <div class="container-page">
    <p class="eyebrow mb-3" data-reveal>{s.contactEyebrow}</p>
    <h2 class="text-3xl font-bold sm:text-4xl" data-reveal data-reveal-delay="80">
      {s.contactTitle}
    </h2>
    <p
      class="mt-4 max-w-2xl text-base leading-relaxed text-fg-soft sm:text-lg"
      data-reveal
      data-reveal-delay="160"
    >
      {s.contactIntro}
    </p>

    <div class="mt-10 flex flex-wrap gap-4" data-reveal data-reveal-delay="240">
      <!-- Email (primary CTA) — address obfuscated, see Email.astro -->
      <Email
        class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-accent-contrast transition-colors hover:bg-accent-hover"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          <path d="m22 7-10 6L2 7"></path>
        </svg>
        {t('contact.email')}
      </Email>

      <!-- GitHub -->
      <a
        href={CONTACTS.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-3 text-sm font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.42.36.8 1.08.8 2.18v3.23c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"></path>
        </svg>
        {t('contact.github')}
      </a>

      <!-- LinkedIn -->
      <a
        href={CONTACTS.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-3 text-sm font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
        </svg>
        {t('contact.linkedin')}
      </a>

      <!-- CV (placeholder PDF — replace /public/cv-matteo-priori.pdf) -->
      <a
        href={SITE.cv}
        download
        class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-3 text-sm font-semibold text-fg transition-colors hover:border-accent hover:text-accent"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <path d="M7 10l5 5 5-5"></path>
          <path d="M12 15V3"></path>
        </svg>
        {t('contact.cv')}
      </a>
    </div>

    <!-- Plain-text fallbacks (also good for crawlers) -->
    <p class="mt-8 font-mono text-sm text-fg-soft" data-reveal>
      <Email class="hover:text-accent" />
      <span class="mx-2 text-border">/</span>
      <a href={CONTACTS.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
        @{CONTACTS.github}
      </a>
    </p>
  </div>
</section>

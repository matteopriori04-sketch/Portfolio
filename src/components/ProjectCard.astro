---
/**
 * ProjectCard — a single project. Renders title, tagline, description, role,
 * optional result callout, stack badges and links (GitHub / demo).
 * "In progress" projects get a status badge instead of a GitHub link.
 */
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/utils';
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  /** Stagger delay (ms) for the scroll-reveal animation. */
  delay?: number;
}
const { project, lang, delay = 0 } = Astro.props;
const t = useTranslations(lang);
---

<article
  id={project.id}
  class="group flex h-full flex-col rounded-2xl border border-border bg-surface p-6 transition-colors hover:border-accent/60 sm:p-8"
  data-reveal
  data-reveal-delay={delay}
>
  <!-- Preview image (optional): acts as the card header -->
  {
    project.image && (
      <div class="mb-6 overflow-hidden rounded-xl border border-border">
        <Image
          src={project.image}
          alt={`${project.title} — preview`}
          widths={[400, 800]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="aspect-video w-full object-cover transition duration-300 group-hover:scale-105 group-hover:brightness-105"
        />
      </div>
    )
  }

  <!-- Header: title + status -->
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-xl font-bold sm:text-2xl">{project.title}</h3>
    {
      project.inProgress && (
        <span class="shrink-0 rounded-full border border-accent/40 bg-accent/10 px-3 py-1 font-mono text-xs font-medium text-accent">
          {t('projects.status_inprogress')}
        </span>
      )
    }
  </div>

  <p class="mt-2 text-sm font-medium text-fg-soft">{project.tagline[lang]}</p>

  <p class="mt-4 text-base leading-relaxed text-fg-soft">
    {project.description[lang]}
  </p>

  <!-- Result callout (optional) -->
  {
    project.highlight && (
      <p class="mt-5 rounded-lg border-l-2 border-accent bg-accent/5 px-4 py-3 text-sm leading-relaxed text-fg">
        <span class="font-mono text-xs uppercase tracking-wider text-accent">
          {t('projects.highlight')}
        </span>
        <span class="mt-1 block">{project.highlight[lang]}</span>
      </p>
    )
  }

  <!-- Role -->
  <p class="mt-5 text-sm leading-relaxed text-fg-soft">
    <span class="font-semibold text-fg">{t('projects.role')}:</span>
    {project.role[lang]}
  </p>

  <!-- Stack badges -->
  <div class="mt-5">
    <p class="mb-2 font-mono text-xs uppercase tracking-wider text-fg-soft">
      {t('projects.stack')}
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        project.stack.map((tech) => (
          <li class="rounded-md border border-border bg-surface-2 px-2.5 py-1 font-mono text-xs text-fg-soft">
            {tech}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Links pinned to the bottom of the card -->
  <div class="mt-6 flex flex-wrap gap-4 pt-2 sm:mt-auto">
    {
      project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent transition-colors hover:text-accent-hover"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.42.36.8 1.08.8 2.18v3.23c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z" />
          </svg>
          {t('projects.github')}
        </a>
      )
    }
    {
      project.demo && (
        <a
          href={project.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-fg transition-colors hover:text-accent"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <path d="M15 3h6v6M10 14 21 3" />
          </svg>
          {t('projects.demo')}
        </a>
      )
    }
  </div>
</article>

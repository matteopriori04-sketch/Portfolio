---
/**
 * HeroBackground — decorative, accessibility-hidden backdrop for the hero.
 *
 * Two layers, both behind the content (-z-10) and non-interactive:
 *  1. A soft teal radial glow (top area).
 *  2. A subtle "node network" — hand-placed circles + connecting lines that
 *     evoke an AI / cybersecurity graph. Static (no JS), low opacity, and
 *     masked with a vertical gradient so it fades out before reaching the
 *     hero text — keeping everything readable.
 *
 * Colour comes from `currentColor` (the accent), so it adapts to the theme;
 * opacity is tuned per theme to stay discreet on both backgrounds.
 */
---

<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
  {/* Soft accent glow */}
  <div
    class="absolute -top-24 left-1/2 h-[28rem] w-[28rem] -translate-x-1/2 rounded-full bg-accent/10 blur-3xl"
  >
  </div>

  {/* Node network */}
  <svg
    class="absolute inset-0 h-full w-full text-accent opacity-[0.13] dark:opacity-[0.20] [mask-image:linear-gradient(to_bottom,black,black_42%,transparent_80%)] [-webkit-mask-image:linear-gradient(to_bottom,black,black_42%,transparent_80%)]"
    viewBox="0 0 1200 800"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
  >
    {/* Connections */}
    <g stroke="currentColor" stroke-width="1">
      <line x1="120" y1="90" x2="300" y2="150"></line>
      <line x1="300" y1="150" x2="240" y2="300"></line>
      <line x1="300" y1="150" x2="430" y2="90"></line>
      <line x1="430" y1="90" x2="520" y2="260"></line>
      <line x1="520" y1="260" x2="660" y2="140"></line>
      <line x1="660" y1="140" x2="900" y2="90"></line>
      <line x1="900" y1="90" x2="1080" y2="150"></line>
      <line x1="1080" y1="150" x2="980" y2="250"></line>
      <line x1="980" y1="250" x2="1120" y2="360"></line>
      <line x1="520" y1="260" x2="760" y2="320"></line>
      <line x1="760" y1="320" x2="980" y2="250"></line>
      <line x1="660" y1="140" x2="760" y2="320"></line>
      <line x1="760" y1="320" x2="840" y2="440"></line>
      <line x1="840" y1="440" x2="1000" y2="430"></line>
      <line x1="1000" y1="430" x2="1120" y2="360"></line>
      <line x1="520" y1="260" x2="640" y2="400"></line>
      <line x1="640" y1="400" x2="760" y2="320"></line>
      <line x1="980" y1="250" x2="1000" y2="430"></line>
      <line x1="840" y1="440" x2="640" y2="400"></line>
    </g>

    {/* Nodes — a few rendered larger as "hubs" */}
    <g fill="currentColor">
      <circle cx="120" cy="90" r="3"></circle>
      <circle cx="300" cy="150" r="4.5"></circle>
      <circle cx="240" cy="300" r="3"></circle>
      <circle cx="430" cy="90" r="3"></circle>
      <circle cx="520" cy="260" r="4.5"></circle>
      <circle cx="660" cy="140" r="4.5"></circle>
      <circle cx="900" cy="90" r="3"></circle>
      <circle cx="760" cy="320" r="3"></circle>
      <circle cx="980" cy="250" r="4.5"></circle>
      <circle cx="1080" cy="150" r="3"></circle>
      <circle cx="1120" cy="360" r="3"></circle>
      <circle cx="640" cy="400" r="3"></circle>
      <circle cx="840" cy="440" r="4.5"></circle>
      <circle cx="1000" cy="430" r="3"></circle>
    </g>
  </svg>
</div>
